{
  "name": "world-evolution",
  "version": "0.1.0",
  "description": "World Evolution V0.1.0 Cross-Platform Foundation",
  "scripts": {
    "dev": "next dev",
    "build": "npm run data:check && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "data:import": "node --import tsx scripts/catalog.ts",
    "data:sql": "node --import tsx scripts/sql.ts",
    "data:check": "node --import tsx scripts/catalog.ts --check && node --import tsx scripts/sql.ts --check && node --import tsx scripts/assets.ts --check",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "check": "npm run data:check && npm run typecheck && npm run lint && npm test && npm run build",
    "assets:manifest": "node --import tsx scripts/assets.ts",
    "test:http": "node --import tsx tests/http-smoke.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "1.75.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "fast-xml-parser": "5.12.1",
    "fflate": "0.8.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0 <25",
    "npm": ">=10"
  }
}
